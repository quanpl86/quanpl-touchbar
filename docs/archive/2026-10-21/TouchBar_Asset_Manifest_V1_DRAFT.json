{
  "specVersion": "1.0.0-draft",
  "project": "TouchBar Character Studio",
  "origin": {
    "url": "https://github.com/Heaaaaaaaa/TouchBar-Pet",
    "branch": "main",
    "notes": "Reference project; verify reuse permissions before republishing modified source."
  },
  "display": {
    "referencePhysicalPixels": {
      "width": 2170,
      "height": 60
    },
    "referencePoints": {
      "width": 1085,
      "height": 30
    },
    "pointsToPhysicalPixels": 2,
    "authoringArtPixelToPhysicalPixels": 4,
    "artPixelToPoint": 2,
    "usableWidthRule": "NEVER hardcode: measure hosted NSView.bounds.width; macOS Control Strip and Escape affect space.",
    "drawHeightPoints": 30,
    "recommendedSafeMarginPoints": {
      "top": 2,
      "bottom": 2
    },
    "coordinateOrigin": "topLeft; screen-right +X; viewport independent from physical strip",
    "interaction": "X-axis primary; Y not relied upon for game decisions",
    "colorSpace": "sRGB",
    "assetFormat": "PNG RGBA transparent; sRGB; nearest-neighbor, no interpolation"
  },
  "legacyAudit": {
    "source": "TouchBar-Pet main 2026-10-21",
    "sceneIntrinsicSizePoints": [
      640,
      30
    ],
    "trackHeightPoints": 28,
    "trackYPoints": 1,
    "trackWidthFormula": "min(max(340, viewWidth-4), 580)",
    "hudStatsPoints": [
      122,
      22
    ],
    "hudStatsYPoints": 4,
    "motionWidthFormula": "max(190, trackWidth-140)",
    "interactionZones": 12,
    "updateTimerHz": 18,
    "currentSpritePoses": 15,
    "currentBackgrounds": 4,
    "currentFoodAssets": 5,
    "knownProblem": "For view width below 344 pt track min 340 may extend beyond bounds; adapt dynamically and clip.",
    "spriteAnimation": "Fixed poses with procedural position/scale/rotation; not complete frame-sequence animation system.",
    "persistentPresentation": "Private macOS API bridge; platform risk."
  },
